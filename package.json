{
  "name": "aryan-portfolio",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "dev": "npm-run-all --parallel next:dev",
    "lint": "next lint",
    "next:dev": "NEXT_PUBLIC_PORT=3000 next --port 3000",
    "build": "rimraf .next && next build",
    "build:start": "rimraf .next && next build --profile && next start",
    "postbuild": "next-sitemap",
    "start": "next start",
    "export": "next build && next export -o .export",
    "analyze": "ANALYZE=true next build",
    "game:map:fetch": "tsx scripts/boring/map/fetch.ts",
    "game:map:build": "tsx scripts/boring/map/build.ts",
    "game:map:validate": "tsx scripts/boring/map/validate.ts",
    "test:game": "tsx --test lib/boring/**/*.test.ts scripts/boring/**/*.test.ts",
    "typecheck:game": "tsc --project tsconfig.boring.json --pretty false"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "resolutions": {
    "autoprefixer": "10.4.5"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "^1.7.2",
    "@heroicons/react": "^2.0.11",
    "@react-icons/all-files": "^4.1.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@react-three/postprocessing": "2.19.1",
    "@types/prismjs": "^1.26.0",
    "@types/three": "0.170.0",
    "framer-motion": "^7.3.6",
    "immer": "^9.0.15",
    "next": "^12.3.1",
    "next-seo": "^5.5.0",
    "next-sitemap": "^3.1.22",
    "next-themes": "0.2.1",
    "nodemailer": "^6.7.8",
    "party-js": "^2.2.0",
    "postprocessing": "6.36.4",
    "prismjs": "^1.29.0",
    "raw-loader": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.4.0",
    "react-tooltip": "^4.2.21",
    "react-use": "^17.4.0",
    "rimraf": "^5.0.1",
    "short-uuid": "^4.2.0",
    "three": "0.170.0",
    "twitter-api-sdk": "^1.1.0",
    "zod": "^3.20.2",
    "zustand": "^4.1.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^12.3.7",
    "@svgr/webpack": "^6.3.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/line-clamp": "^0.4.2",
    "@tailwindcss/typography": "^0.5.7",
    "@types/node": "^18.7.18",
    "@types/react": "^18.0.20",
    "@types/react-dom": "^18.0.6",
    "autoprefixer": "10.4.5",
    "clsx": "^1.2.1",
    "csstype": "^3.2.3",
    "fx-style": "^2.0.1",
    "mini-svg-data-uri": "^1.4.4",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.16",
    "postcss-import": "^15.0.0",
    "sass": "^1.57.1",
    "tailwind-children": "^0.5.0",
    "tailwind-gradient-mask-image": "^1.0.0",
    "tailwindcss": "^3.1.8",
    "type-fest": "^3.0.0",
    "typescript": "^4.8.3",
    "tsx": "^4.19.2"
  },
  "typeRoots": [
    "./node_modules/@types",
    "./types"
