{
  "name": "aryan-intro-reel",
  "version": "1.0.0",
  "description": "Silent comic-style Remotion intro reel for Aryan Vijaywargia.",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.473",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.473"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.473",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render AryanIntro out/AryanIntro.raw.mp4 && ffmpeg -y -i out/AryanIntro.raw.mp4 -map_metadata -1 -c:v copy -an out/AryanIntro.mp4 && rm out/AryanIntro.raw.mp4",
    "still": "remotion still AryanIntro --frame=450 --scale=0.5 out/AryanIntro-frame450.png",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
